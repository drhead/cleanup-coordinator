FROM postgres:16 AS builder

# Install build dependencies matching Postgres 16
RUN apt-get update && apt-get -y install \
    git \
    postgresql-server-dev-16 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Clone and build pg_ivm
RUN git clone https://github.com/sraoss/pg_ivm.git /pg_ivm
WORKDIR /pg_ivm

RUN git checkout v1.9
RUN make
RUN make DESTDIR=/pg_ivm/output install

# Final runtime stage
FROM postgres:16
COPY --from=builder /pg_ivm/output /